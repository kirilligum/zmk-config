// Settings tuned for 3840 x 2160 display resolution
#define ZMK_POINTING_DEFAULT_MOVE_VAL 600 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20  // 10

#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

// Based on @caksoylar's config, defaults in comments
&mmv {
  acceleration-exponent = <1>;          // 1
  time-to-max-speed-ms = <500>;         // 300
  delay-ms = <0>;                       // 0
};

&msc {
  acceleration-exponent = <0>;          // 0
  time-to-max-speed-ms = <300>;         // 300
  delay-ms = <0>;                       // 0
};

&mmv_input_listener {
  warp {
    layers = <NAV>;
    input-processors = <&zip_xy_scaler 4 1>;
  };
  precision {
    layers = <FN>;
    input-processors = <&zip_xy_scaler 1 4>;
  };
};

/ {
  zip_scroll_scaler: zip_scroll_scaler {
    compatible = "zmk,input-processor-scaler";
    #input-processor-cells = <2>;
    type = <INPUT_EV_REL>;
    codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
    track-remainders;
  };
};

&msc_input_listener {
  warp {
    layers = <NAV>;
    input-processors = <&zip_scroll_scaler 4 1>;
  };
  precision {
    layers = <FN>;
    input-processors = <&zip_scroll_scaler 1 4>;
  };
};

// Persistent mouse-button locks. A lock layer records the held button so the
// same combo releases it; choosing another lock transfers the hold.
#define MOUSE_LOCK_ON(NAME, BUTTON, LAYER)                                    \
  ZMK_MACRO(NAME, wait-ms = <0>; tap-ms = <0>;                               \
            bindings = <&macro_press &mkp BUTTON &tog LAYER>;)

#define MOUSE_LOCK_OFF(NAME, BUTTON, LAYER)                                   \
  ZMK_MACRO(NAME, wait-ms = <0>; tap-ms = <0>;                               \
            bindings = <&macro_release &mkp BUTTON                            \
                        &macro_press &tog LAYER>;)

#define MOUSE_LOCK_SWITCH(NAME, FROM_BUTTON, TO_BUTTON, FROM_LAYER, TO_LAYER) \
  ZMK_MACRO(NAME, wait-ms = <0>; tap-ms = <0>;                               \
            bindings = <&macro_release &mkp FROM_BUTTON                       \
                        &macro_press &mkp TO_BUTTON                           \
                        &tog FROM_LAYER &tog TO_LAYER>;)

#define MOUSE_LOCK_EXIT(NAME, BUTTON)                                         \
  ZMK_MACRO(NAME, wait-ms = <0>; tap-ms = <0>;                               \
            bindings = <&macro_release &mkp BUTTON                            \
                        &macro_press &to DEF>;)

MOUSE_LOCK_ON(mouse_r_lock_on, RCLK, MOUSE_R_LOCK)
MOUSE_LOCK_ON(mouse_m_lock_on, MCLK, MOUSE_M_LOCK)
MOUSE_LOCK_ON(mouse_l_lock_on, LCLK, MOUSE_L_LOCK)

MOUSE_LOCK_OFF(mouse_r_lock_off, RCLK, MOUSE_R_LOCK)
MOUSE_LOCK_OFF(mouse_m_lock_off, MCLK, MOUSE_M_LOCK)
MOUSE_LOCK_OFF(mouse_l_lock_off, LCLK, MOUSE_L_LOCK)

MOUSE_LOCK_SWITCH(mouse_r_to_m, RCLK, MCLK, MOUSE_R_LOCK, MOUSE_M_LOCK)
MOUSE_LOCK_SWITCH(mouse_r_to_l, RCLK, LCLK, MOUSE_R_LOCK, MOUSE_L_LOCK)
MOUSE_LOCK_SWITCH(mouse_m_to_r, MCLK, RCLK, MOUSE_M_LOCK, MOUSE_R_LOCK)
MOUSE_LOCK_SWITCH(mouse_m_to_l, MCLK, LCLK, MOUSE_M_LOCK, MOUSE_L_LOCK)
MOUSE_LOCK_SWITCH(mouse_l_to_r, LCLK, RCLK, MOUSE_L_LOCK, MOUSE_R_LOCK)
MOUSE_LOCK_SWITCH(mouse_l_to_m, LCLK, MCLK, MOUSE_L_LOCK, MOUSE_M_LOCK)

MOUSE_LOCK_EXIT(mouse_r_lock_exit, RCLK)
MOUSE_LOCK_EXIT(mouse_m_lock_exit, MCLK)
MOUSE_LOCK_EXIT(mouse_l_lock_exit, LCLK)

#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define U_WH_U &msc SCRL_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT
