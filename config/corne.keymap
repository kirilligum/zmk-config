#define CONFIG_WIRELESS

/*
 * Urob's core layout is 34 keys. On the Chocofi's 36-key physical layout,
 * the two outer thumb keys type reusable reasoning prompts. Pressing both
 * outer thumbs together types the structured execution-planning prompt.
 */
#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)                   \
    ZMK_LAYER(                                                                 \
        name,                                                                  \
                 LT RT                                                         \
                 LM RM                                                         \
                 LB RB                                                         \
        &prompt_reasoning LH RH &prompt_execution                              \
    )

#include "zmk-helpers/key-labels/36.h"
#include "base.keymap"
#include "prompts.dtsi"

/ {
  chosen {
    zmk,physical-layout = &foostan_corne_5col_layout;
  };
};
